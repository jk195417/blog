<%# One torn-off page: a date tile and the post's title. %>
<a class="sheet" href="<%- url_for(post.path) %>">
  <span class="tile<%= red ? ' r' : '' %>"><i class="num"><%= post.date.format('YYYY.MM') %></i><b class="num"><%= post.date.format('DD') %></b></span>
  <span>
    <span class="t"><%= post.title %></span>
    <span class="m"><%
      const bits = [];
      if (post.categories && post.categories.length) bits.push(post.categories.map((c) => c.name).join('、'));
      if (post.tags && post.tags.length) bits.push(post.tags.map((t) => t.name).slice(0, 4).join('、'));
      %><%= bits.join(' · ') %></span>
  </span>
</a>
